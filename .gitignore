# ============================================
# SmartFix Root .gitignore
# ============================================

# Dependencies — never commit node_modules
node_modules/
**/node_modules/

# Environment variables — NEVER commit any .env file
.env
**/.env
.env.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.test
.env.test.local
**/.env.example

# Firebase / Service Account credentials
firebase-service-account.json
**/firebase-service-account.json
service-account.json
**/*service-account*.json
!**/*service-account.example.json

# Build outputs
dist/
build/
**/dist/
**/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SSL Certificates
certs/
*.pem

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Vite cache
.vite/
**/.vite/
